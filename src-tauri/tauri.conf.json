{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OPEN AIGC",
  "version": "0.2.0",
  "identifier": "com.aigcstudio.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --port 1421",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OPEN AIGC",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "scrollBarStyle": "fluentOverlay",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' blob: data: asset: https://*.byteimg.com https://*.toutiaoimg.com",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1421",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1421",
        "img-src": "'self' blob: data: asset: https://*.byteimg.com https://*.toutiaoimg.com",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
