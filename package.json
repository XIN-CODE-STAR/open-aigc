{
  "name": "aigc-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "check:rust": "node scripts/run-with-rust-path.mjs cargo fmt --manifest-path src-tauri/Cargo.toml --check && node scripts/run-with-rust-path.mjs cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{js,mjs,ts}\" \"*.{json,js,mjs,ts,yml,yaml,html}\" \".github/**/*.{yml,yaml}\" \"src-tauri/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"scripts/**/*.{js,mjs,ts}\" \"*.{json,js,mjs,ts,yml,yaml,html}\" \".github/**/*.{yml,yaml}\" \"src-tauri/**/*.json\"",
    "licenses:check": "pnpm licenses list --prod --long",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "tauri": "node scripts/run-with-rust-path.mjs tauri",
    "test": "vitest run",
    "test:rust": "node scripts/rust-test.mjs",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@tanstack/vue-table": "8.21.3",
    "@tauri-apps/api": "^2.11.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "ogl": "^1.0.11",
    "pinia": "^3.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^2.1.10"
  }
}
